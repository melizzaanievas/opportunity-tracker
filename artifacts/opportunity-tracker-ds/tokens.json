{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the Opportunity Tracker visual language. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. Colors are authored as hex; the generator converts them to H S% L% channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#181935", "$description": "Deep indigo atmosphere behind the translucent workspace." },
      "foreground": { "$value": "#f4effa" },
      "border": { "$value": "#766b9b" },
      "card": { "$value": "#292952" },
      "cardForeground": { "$value": "#f4effa" },
      "popover": { "$value": "#292952" },
      "popoverForeground": { "$value": "#f4effa" },
      "primary": {
        "$value": "#f3e5ab",
        "$description": "Gold focus accent used for important actions, deadlines, and active emphasis."
      },
      "primaryForeground": { "$value": "#181935" },
      "secondary": { "$value": "#7c6c9b", "$description": "Dusty lavender used for supporting controls and secondary surfaces." },
      "secondaryForeground": { "$value": "#f4effa" },
      "muted": { "$value": "#4a4570" },
      "mutedForeground": { "$value": "#dcd6e8" },
      "accent": { "$value": "#a88fca", "$description": "Soft periwinkle accent for selected states and secondary emphasis." },
      "accentForeground": { "$value": "#181935" },
      "destructive": { "$value": "#d86a7b" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#6d638e" },
      "ring": { "$value": "#f3e5ab" },
      "chart1": { "$value": "#f3e5ab" },
      "chart2": { "$value": "#a88fca" },
      "chart3": { "$value": "#9fd8d2" },
      "chart4": { "$value": "#f09a88" },
      "chart5": { "$value": "#d6b3ef" },
      "sidebar": { "$value": "#0e0d22" },
      "sidebarForeground": { "$value": "#f4effa" },
      "sidebarBorder": { "$value": "#423b65" },
      "sidebarPrimary": { "$value": "#f3e5ab" },
      "sidebarPrimaryForeground": { "$value": "#181935" },
      "sidebarAccent": { "$value": "#292952" },
      "sidebarAccentForeground": { "$value": "#f4effa" },
      "sidebarRing": { "$value": "#f3e5ab" }
    },
    "dark": {
      "background": { "$value": "#0e0d22" },
      "foreground": { "$value": "#f8f5ff" },
      "border": { "$value": "#4a4570" },
      "card": { "$value": "#181935" },
      "cardForeground": { "$value": "#f8f5ff" },
      "popover": { "$value": "#181935" },
      "popoverForeground": { "$value": "#f8f5ff" },
      "primary": { "$value": "#f3e5ab" },
      "primaryForeground": { "$value": "#0e0d22" },
      "secondary": { "$value": "#4a4570" },
      "secondaryForeground": { "$value": "#f4effa" },
      "muted": { "$value": "#292952" },
      "mutedForeground": { "$value": "#a8a0be" },
      "accent": { "$value": "#bba9dc" },
      "accentForeground": { "$value": "#0e0d22" },
      "destructive": { "$value": "#d0526b" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#4a4570" },
      "ring": { "$value": "#f3e5ab" },
      "chart1": { "$value": "#f3e5ab" },
      "chart2": { "$value": "#bba9dc" },
      "chart3": { "$value": "#9fd8d2" },
      "chart4": { "$value": "#f09a88" },
      "chart5": { "$value": "#d6b3ef" },
      "sidebar": { "$value": "#080719" },
      "sidebarForeground": { "$value": "#f8f5ff" },
      "sidebarBorder": { "$value": "#292952" },
      "sidebarPrimary": { "$value": "#f3e5ab" },
      "sidebarPrimaryForeground": { "$value": "#0e0d22" },
      "sidebarAccent": { "$value": "#181935" },
      "sidebarAccentForeground": { "$value": "#f8f5ff" },
      "sidebarRing": { "$value": "#f3e5ab" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Plus Jakarta Sans", "Inter", "system-ui", "sans-serif"],
        "$description": "Default UI, body, navigation, and form typeface extracted from the app."
      },
      "serif": {
        "$value": ["Cormorant Garamond", "Georgia", "serif"],
        "$description": "Editorial display face for headings and moments of hierarchy."
      },
      "mono": {
        "$value": ["Plus Jakarta Sans", "Inter", "sans-serif"],
        "$description": "The source has no dedicated mono face; compact metadata stays in the UI sans family."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Base corner radius; the source uses 16px glass cards and softer 8px fields."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
