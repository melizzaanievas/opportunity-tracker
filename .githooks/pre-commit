#!/usr/bin/env sh
# Pre-commit hook: block SQLite database files and secrets from being committed.
# Covers the raw DB file and the WAL/shared-memory side-car files.

BLOCKED=$(git diff --cached --name-only | grep -E '\.(db|db-shm|db-wal|sqlite|sqlite3)$')

if [ -n "$BLOCKED" ]; then
  echo ""
  echo "❌  Commit blocked — database file(s) are staged:"
  echo ""
  echo "$BLOCKED" | sed 's/^/    /'
  echo ""
  echo "These files must never be committed. To unstage them, run:"
  echo ""
  echo "$BLOCKED" | sed 's/^/    git restore --staged /'
  echo ""
  echo "If the file was committed previously and needs to be removed from"
  echo "history, see the Gotchas section in replit.md."
  echo ""
  exit 1
fi

# ── Scan staged changes for secrets ────────────────────────────────────────────
# Use the same patterns as the pre-push hook, but inspect only added staged lines
# so secrets are caught before they enter local commit history.
#
# To bypass a confirmed false positive (use sparingly):
#   SKIP_SECRET_SCAN=1 git commit

# Using -f avoids shell word-splitting and prevents patterns starting with '-'
# from being misread as grep flags. Resolve the shared source relative to this
# hook so it works regardless of the caller's working directory.
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd) || exit 1
PATTERN_FILE="$HOOK_DIR/secret-patterns"

ADDED_LINES=$(git diff --cached -p --diff-filter=ACM | grep '^+' | grep -v '^+++' || true)
MATCHES=$(printf '%s\n' "$ADDED_LINES" | grep -En -f "$PATTERN_FILE" 2>/dev/null || true)

if [ -n "$MATCHES" ]; then
  printf '\n'
  printf '🔴  Commit blocked — potential secrets detected in staged changes\n'
  printf '\n'
  printf '  Matched lines (first 10 shown):\n'
  printf '\n'
  printf '%s\n' "$MATCHES" | head -10 | sed 's/^/    /'
  printf '\n'
  printf -- '──────────────────────────────────────────────────────────────────────\n'
  printf '\n'
  printf '  Remediation steps:\n'
  printf '\n'
  printf '  1. Remove the secret from the file and use an environment variable\n'
  printf '     or a Replit secret instead (Secrets panel → + New secret).\n'
  printf '\n'
  printf '  2. If the secret was already committed, rewrite history:\n'
  printf '       git rebase -i <commit-before-leak>   # drop or edit the bad commit\n'
  printf '     OR reset the most recent commit:\n'
  printf '       git reset HEAD~1                      # unstage & recommit cleanly\n'
  printf '\n'
  printf '  3. Rotate the leaked credential immediately — treat it as compromised.\n'
  printf '\n'
  printf '  4. If the file should never be tracked, add it to .gitignore:\n'
  printf '       echo "path/to/file" >> .gitignore\n'
  printf '\n'
  printf '  To bypass a confirmed false positive:\n'
  printf '       SKIP_SECRET_SCAN=1 git commit\n'
  printf '  (use sparingly — report false positives so patterns can be improved)\n'
  printf '\n'

  if [ "${SKIP_SECRET_SCAN:-0}" = "1" ]; then
    printf '  ⚠️   SKIP_SECRET_SCAN=1 set — bypassing block.\n\n'
    exit 0
  fi
  exit 1
fi

exit 0
