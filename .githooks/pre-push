#!/usr/bin/env sh
# Pre-push hook: scan outgoing commits for secrets and sensitive data.
# Blocks the push and prints actionable remediation steps when detected.
#
# Wired automatically via `pnpm install` → `prepare` → `git config core.hooksPath .githooks`
#
# To bypass a confirmed false positive (use sparingly):
#   SKIP_SECRET_SCAN=1 git push

# ── Load shared secret patterns ──────────────────────────────────────────────
# Using -f avoids shell word-splitting and prevents patterns starting with '-'
# from being misread as grep flags. Resolve the source relative to this hook
# so it works regardless of the caller's working directory.
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd) || exit 1
PATTERN_FILE="$HOOK_DIR/secret-patterns"

FOUND_SECRETS=0
FINDINGS=""

# ── Scan each ref being pushed ────────────────────────────────────────────────
while read LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  # Skip branch deletions
  if [ "$LOCAL_SHA" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  # Determine commit range
  if [ "$REMOTE_SHA" = "0000000000000000000000000000000000000000" ]; then
    # New remote branch: scan commits not yet on any remote
    PATCH=$(git log -p --diff-filter=ACM "$LOCAL_SHA" --not --remotes 2>/dev/null)
  else
    PATCH=$(git diff -p --diff-filter=ACM "$REMOTE_SHA..$LOCAL_SHA" 2>/dev/null)
  fi

  [ -z "$PATCH" ] && continue

  # Only inspect added lines (lines starting with +, excluding +++ header lines)
  ADDED_LINES=$(printf '%s\n' "$PATCH" | grep '^+' | grep -v '^+++')

  MATCHES=$(printf '%s\n' "$ADDED_LINES" | grep -En -f "$PATTERN_FILE" 2>/dev/null || true)

  if [ -n "$MATCHES" ]; then
    FOUND_SECRETS=1
    # Show at most 10 matching lines to keep output readable
    FINDINGS="${FINDINGS}$(printf '%s\n' "$MATCHES" | head -10 | sed 's/^/    /')\n"
  fi
done

# ── Report and block ──────────────────────────────────────────────────────────
if [ "$FOUND_SECRETS" -eq 1 ]; then
  printf '\n'
  printf '🔴  Push blocked — potential secrets detected in outgoing commits\n'
  printf '\n'
  printf '  Matched lines (first 10 shown per push ref):\n'
  printf '\n'
  printf '%b' "$FINDINGS"
  printf '\n'
  printf -- '──────────────────────────────────────────────────────────────────────\n'
  printf '\n'
  printf '  Remediation steps:\n'
  printf '\n'
  printf '  1. Remove the secret from the file and use an environment variable\n'
  printf '     or a Replit secret instead (Secrets panel → + New secret).\n'
  printf '\n'
  printf '  2. Rotate the leaked credential immediately — treat it as compromised.\n'
  printf '\n'
  printf '  3. Purge the secret from all Git history with git-filter-repo:\n'
  printf '     See SECURITY.md#purge-a-secret-from-git-history for the runbook.\n'
  printf '\n'
  printf '  4. If the file should never be tracked, add it to .gitignore:\n'
  printf '       echo "path/to/file" >> .gitignore\n'
  printf '\n'
  printf '  To bypass a confirmed false positive:\n'
  printf '       SKIP_SECRET_SCAN=1 git push\n'
  printf '  (use sparingly — report false positives so patterns can be improved)\n'
  printf '\n'

  if [ "${SKIP_SECRET_SCAN:-0}" = "1" ]; then
    printf '  ⚠️   SKIP_SECRET_SCAN=1 set — bypassing block.\n\n'
    exit 0
  fi
  exit 1
fi

exit 0
