{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "prepare": "is-ci || git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "start": "node artifacts/api-server/dist/index.js",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "build": "pnpm -r --filter \"./artifacts/**\" run build",
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@rollup/rollup-linux-x64-musl"
    ],
    "overrides": {
      "fast-uri": "3.1.6",
      "qs": "6.16.0",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "esbuild@<=0.24.2": "0.25.5"
    }
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
